+@media (min-width: 900px) {
+  main {
+    display: grid;
+    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
+    grid-template-areas:
+      "heading heading"
+      "refresh refresh"
+      "warning warning"
+      "overview history"
+      "schedule history"
+      "system system"
+      "footer footer";
+    gap: 20px 40px;
+    padding-top: 32px;
+  }
+  header { grid-area: heading; align-items: center; }
+  .refresh {
+    grid-area: refresh;
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    padding: 12px 0;
   }
+  .refresh p { flex: 1; }
+  .refresh button { margin: 0; min-height: 44px; }
+  #warning { grid-area: warning; margin: 0; }
+  #warning:empty { display: none; }
+  .overview {
+    grid-area: overview;
+    flex-direction: column;
+    gap: 20px;
+    margin: 0;
+  }
+  .overview > section + section {
+    border-top: 1px solid var(--line);
+    padding-top: 16px;
+  }
+  #next-action { font-size: 24px; font-weight: 600; }
+  .daily-schedule { grid-area: schedule; }
+  .schedule-times { margin: 10px 0; }
+  .history {
+    grid-area: history;
+    margin: 0;
+    padding: 0 0 0 28px;
+    border-top: 0;
+    border-left: 1px solid var(--line);
+  }
+  .history th, .history td { padding: 12px 4px; }
+  .system {
+    grid-area: system;
+    margin-top: 0;
+    padding-top: 8px;
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 32px;
+  }
+  footer { grid-area: footer; }
 }
