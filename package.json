{
  "name": "viewrule",
  "version": "0.4.0",
  "description": "Design guidance and executable UI constraints for coding agents, with full-resolution evidence and human feedback.",
  "type": "module",
  "license": "MIT",
  "author": "Viewrule contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanej/viewrule.git"
  },
  "bugs": {
    "url": "https://github.com/lanej/viewrule/issues"
  },
  "homepage": "https://github.com/lanej/viewrule#readme",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "viewrule": "bin/viewrule.mjs",
    "ui-review": "bin/viewrule.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "presets/",
    "npm-shrinkwrap.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/test-package.mjs",
    "demo": "node demo.mjs",
    "site:build": "node scripts/site.mjs",
    "site:preview": "node scripts/site.mjs --serve",
    "browser:install": "node bin/viewrule.mjs install-browser",
    "lint": "eslint . --max-warnings 0",
    "analyze": "tsc --project tsconfig.json",
    "check": "npm run format:ci && npm run lint && npm run analyze",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:ci": "prettier --write . && git diff --exit-code"
  },
  "keywords": [
    "ui",
    "design-rules",
    "playwright",
    "layout",
    "visual-review"
  ],
  "dependencies": {
    "@axe-core/playwright": "4.10.2",
    "ajv": "8.17.1",
    "mustache": "4.2.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mustache": "4.2.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
